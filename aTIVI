CREATE TABLE clientes (
    idcliente INTEGER NOT NULL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(14) NOT NULL,
    email VARCHAR(100) NOT NULL
);

CREATE TABLE enderecos (
    id_endereco INTEGER NOT NULL PRIMARY KEY,
    rua VARCHAR(100) NOT NULL,
    numero VARCHAR(20) NOT NULL,
    cep VARCHAR(14) NOT NULL,
    cidade VARCHAR(100) NOT NULL,
    estado VARCHAR(30) NOT NULL,
    idcliente INTEGER NOT NULL,
    FOREIGN KEY (idcliente) REFERENCES clientes(idcliente)
);

CREATE TABLE contatos_clientes (
    id_contato INTEGER NOT NULL PRIMARY KEY,
    telefone VARCHAR(20) NOT NULL,
    idcliente INTEGER NOT NULL,
    FOREIGN KEY (idcliente) REFERENCES clientes(idcliente)
);

CREATE TABLE mecanicos (
    idmecanico INTEGER NOT NULL PRIMARY KEY,
    especialidade VARCHAR(100) NOT NULL,
    nome VARCHAR(100) NOT NULL
);

CREATE TABLE contatos_mecanicos (
    id_contato INTEGER NOT NULL PRIMARY KEY,
    telefone VARCHAR(20) NOT NULL,
    idmecanico INTEGER NOT NULL,
    FOREIGN KEY (idmecanico) REFERENCES mecanicos(idmecanico)
);

CREATE TABLE veiculos (
    id_veiculo INTEGER NOT NULL PRIMARY KEY,
    placa VARCHAR(8) NOT NULL,
    modelo VARCHAR(50) NOT NULL,
    marca VARCHAR(50) NOT NULL,
    ano INTEGER NOT NULL,
    idcliente INTEGER NOT NULL,
    FOREIGN KEY (idcliente) REFERENCES clientes(idcliente)
);

CREATE TABLE ordens_servicos (
    id_ordem_servico INTEGER NOT NULL PRIMARY KEY,
    identificador VARCHAR(50) NOT NULL,
    data_abertura DATE NOT NULL,
    data_conclusao DATE NOT NULL,
    status VARCHAR(50) NOT NULL,
    id_veiculo INTEGER NOT NULL,
    FOREIGN KEY (id_veiculo) REFERENCES veiculos(id_veiculo)
);

CREATE TABLE servicos (
    id_servico INTEGER NOT NULL PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL,
    valor_base DOUBLE NOT NULL
);

CREATE TABLE produtos (
    id_produto INTEGER NOT NULL PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    preco_unit DOUBLE NOT NULL
);

CREATE TABLE ordens_servicos_mecanicos (
    id_ordem_servico INTEGER NOT NULL,
    idmecanico INTEGER NOT NULL,
    PRIMARY KEY (id_ordem_servico, idmecanico),
    FOREIGN KEY (id_ordem_servico) REFERENCES ordens_servicos(id_ordem_servico),
    FOREIGN KEY (idmecanico) REFERENCES mecanicos(idmecanico)
);

CREATE TABLE ordens_servicos_servicos (
    id_ordem_servico INTEGER NOT NULL,
    id_servico INTEGER NOT NULL,
    quatidade INTEGER NOT NULL,
    valor_cobrado DOUBLE NOT NULL,
    PRIMARY KEY (id_ordem_servico, id_servico),
    FOREIGN KEY (id_ordem_servico) REFERENCES ordens_servicos(id_ordem_servico),
    FOREIGN KEY (id_servico) REFERENCES servicos(id_servico)
);

CREATE TABLE ordens_servicos_produtos (
    id_ordem_servico INTEGER NOT NULL,
    id_produto INTEGER NOT NULL,
    quantidade DOUBLE NOT NULL,
    preco_aplicado DOUBLE NOT NULL,
    PRIMARY KEY (id_ordem_servico, id_produto),
    FOREIGN KEY (id_ordem_servico) REFERENCES ordens_servicos(id_ordem_servico),
    FOREIGN KEY (id_produto) REFERENCES produtos(id_produto)
);

