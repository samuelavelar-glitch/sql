
CREATE TABLE planos_saude(
id_plano_saude INTEGER PRIMARY KEY,
nome_operadora VARCHAR(30) NOT NULL,
telefone VARCHAR(14)NOT NULL
);
CREATE TABLE  procedimentos(
id_procedimentos INTEGER PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
descricao VARCHAR(200) NOT NULL,
custo DOUBLE PRECISION NOT NULL
);
CREATE TABLE medicamentos (
id_medicamento INTEGER PRIMARY KEY,
nome_comercial VARCHAR(100) NOT NULL,
principal_ativo VARCHAR(200) NOT NULL,
fabricante VARCHAR(100)NOT NULL
);
CREATE TABLE especialidades(
id_especialidade INTEGER PRIMARY KEY,
nome VARCHAR(100)NOT NULL,
descricao VARCHAR(100) NOT NULL
);
CREATE TABLE pacientes(
id_paciente INTEGER PRIMARY KEY,
nome VARCHAR(100) NOT NULL,
data_nascimento DATE NOT NULL,
sexo VARCHAR(10) NOT NULL,
cpf VARCHAR(14) NOT NULL,
id_plano_saude INTEGER NOT NULL,
FOREIGN KEY (id_plano_saude )REFERENCES planos_saude(id_plano_saude)
);
CREATE TABLE medicos(
id_medico INTEGER PRIMARY KEY,
nome VARCHAR (100) NOT NULL,
crm VARCHAR(100) NOT NULL,
telefone VARCHAR (12) NOT NULL,
id_especialidade INTEGER NOT NULL,
FOREIGN KEY (id_especialidade) REFERENCES especialidades (id_especialidade)
);
CREATE TABLE enderecos(
id_endereco INTEGER PRIMARY KEY,
rua VARCHAR(100) NOT NULL,
numero VARCHAR(10) NOT NULL,
bairro VARCHAR(100)NOT NULL,
cidade VARCHAR(80)NOT NULL,
estado VARCHAR(50) NOT NULL,
id_paciente INTEGER NOT NULL,
FOREIGN KEY (id_paciente) REFERENCES pacientes (id_paciente)
);
CREATE TABLE contatos(
id_contato INTEGER PRIMARY KEY,
tipo_contato VARCHAR(20)NOT NULL,
telefone VARCHAR(14)NOT NULL,
id_paciente INTEGER NOT NULL,
FOREIGN KEY (id_paciente) REFERENCES pacientes (id_paciente)
);
CREATE TABLE consultas(
id_consultas INTEGER PRIMARY KEY,
numero_registro INTEGER NOT NULL,
data_consulta DATE NOT NULL,
horario TIME NOT NULL,
observacoes VARCHAR(1000) NOT NULL,
id_paciente INTEGER NOT NULL,
id_medico INTEGER NOT NULL,
FOREIGN KEY (id_paciente) REFERENCES pacientes (id_paciente),
FOREIGN KEY (id_medico) REFERENCES medicos (id_medico) 
);
CREATE TABLE consultas_medicamento(
id_consultas INTEGER NOT NULL,
id_medicamento INTEGER NOT NULL,
dosagem DOUBLE PRECISION NOT NULL,
frequencia_uso VARCHAR(150) NOT NULL,
duracao_tratamento VARCHAR(20)NOT NULL,
observacoes VARCHAR(100) NOT NULL,
PRIMARY KEY(id_consultas ,id_medicamento),
FOREIGN KEY (id_consultas) REFERENCES consultas (id_consultas),
FOREIGN KEY (id_medicamento) REFERENCES medicamentos (id_medicamento)
);
CREATE TABLE consultas_procedimentos(
id_consultas INTEGER NOT NULL,
id_procedimentos INTEGER NOT NULL,
data_realizacao DATE NOT NULL,
quantidade DOUBLE PRECISION NOT NULL,
valor_cobrado DOUBLE PRECISION NOT NULL,
PRIMARY KEY(id_consultas ,id_procedimentos),
FOREIGN KEY (id_consultas) REFERENCES consultas (id_consultas),
FOREIGN KEY (id_procedimentos) REFERENCES procedimentos (id_procedimentos)
);
