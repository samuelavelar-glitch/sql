DROP TABLE IF EXISTS dados_pagamentos CASCADE;
DROP TABLE IF EXISTS rotas_pedidos CASCADE;
DROP TABLE IF EXISTS rotas CASCADE;
DROP TABLE IF EXISTS itens_pedido CASCADE;
DROP TABLE IF EXISTS pedidos CASCADE;
DROP TABLE IF EXISTS manutencoes CASCADE;
DROP TABLE IF EXISTS motoristas CASCADE;
DROP TABLE IF EXISTS veiculos CASCADE;
DROP TABLE IF EXISTS funcionarios CASCADE;
DROP TABLE IF EXISTS armazens CASCADE;
DROP TABLE IF EXISTS enderecos CASCADE;
DROP TABLE IF EXISTS clientes CASCADE;

CREATE TABLE clientes (
    id_cliente INTEGER PRIMARY KEY,
    nome_razao_social VARCHAR(100) NOT NULL,
    documento VARCHAR(20) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL,
    telefone VARCHAR(30) NOT NULL,
    tipo VARCHAR(10) NOT NULL CHECK (tipo IN ('PF', 'PJ'))
);

ALTER TABLE clientes ADD COLUMN telefone_2 VARCHAR(30);

CREATE TABLE enderecos (
    id_endereco INTEGER PRIMARY KEY,
    cep VARCHAR(9) NOT NULL,
    logradouro VARCHAR(50) NOT NULL,
    rua VARCHAR(80) NOT NULL,
    numero VARCHAR(20) NOT NULL,
    bairro VARCHAR(50) NOT NULL,
    municipio VARCHAR(50) NOT NULL,
    estado CHAR(2) NOT NULL,
    id_cliente INTEGER NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente) ON DELETE CASCADE
);

CREATE TABLE armazens (
    id_armazem INTEGER PRIMARY KEY,
    nome_armazem VARCHAR(80) NOT NULL,
    local_armazem VARCHAR(80) NOT NULL,
    capacidade_armazem NUMERIC(12,2) NOT NULL CHECK (capacidade_armazem > 0),
    custo_armazenagem NUMERIC(12,2) NOT NULL DEFAULT 0
);

CREATE TABLE funcionarios (
    id_funcionario INTEGER PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    especialidade VARCHAR(100) NOT NULL,
    cargo VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    id_armazem INTEGER NOT NULL,
    FOREIGN KEY (id_armazem) REFERENCES armazens(id_armazem)
);

CREATE TABLE veiculos (
    id_veiculo INTEGER PRIMARY KEY,
    placa VARCHAR(20) NOT NULL UNIQUE,
    ano_fabricacao INTEGER NOT NULL CHECK (ano_fabricacao >= 1990),
    capacidade_peso_kg INTEGER NOT NULL CHECK (capacidade_peso_kg > 0),
    conservacao_veiculo VARCHAR(20) NOT NULL CHECK (conservacao_veiculo IN ('Ótimo', 'Bom', 'Regular', 'Ruim'))
);

CREATE TABLE motoristas (
    id_motorista INTEGER PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cnh VARCHAR(50) NOT NULL UNIQUE,
    tipo_cnh VARCHAR(10) NOT NULL CHECK (tipo_cnh IN ('B', 'C', 'D', 'E')),
    valida BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE manutencoes (
    id_manutencao INTEGER PRIMARY KEY,
    data_manutencao DATE NOT NULL,
    data_inicio DATE NOT NULL,
    data_fim DATE,
    id_veiculo INTEGER NOT NULL,
    tipo VARCHAR(50) NOT NULL CHECK (tipo IN ('Preventiva', 'Corretiva')),
    descricao TEXT,
    custo NUMERIC(10,2) NOT NULL CHECK (custo >= 0),
    FOREIGN KEY (id_veiculo) REFERENCES veiculos(id_veiculo)
);

CREATE TABLE pedidos (
    id_pedido INTEGER PRIMARY KEY,
    data_pedido DATE NOT NULL DEFAULT CURRENT_DATE,
    status_pedido VARCHAR(30) NOT NULL DEFAULT 'Em Processamento',
    valor_pedido NUMERIC(10,2) NOT NULL CHECK (valor_pedido >= 0),
    local_pedido VARCHAR(50) NOT NULL,
    qtd INTEGER NOT NULL CHECK (qtd > 0),
    id_cliente INTEGER NOT NULL,
    id_endereco_entrega INTEGER NOT NULL,
    id_armazem_origem INTEGER NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
    FOREIGN KEY (id_endereco_entrega) REFERENCES enderecos(id_endereco),
    FOREIGN KEY (id_armazem_origem) REFERENCES armazens(id_armazem)
);

CREATE TABLE itens_pedido (
    id_item INTEGER PRIMARY KEY,
    id_pedido INTEGER NOT NULL,
    qtd_item INTEGER NOT NULL CHECK (qtd_item > 0),
    valor_unit NUMERIC(10,2) NOT NULL CHECK (valor_unit >= 0),
    descricao_item TEXT NOT NULL,
    FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido) ON DELETE CASCADE
);

CREATE TABLE rotas (
    id_rota INTEGER PRIMARY KEY,
    origem VARCHAR(100) NOT NULL,
    destino VARCHAR(100) NOT NULL,
    distancia_km NUMERIC(8,2) NOT NULL CHECK (distancia_km > 0),
    tempo_estimado INTERVAL NOT NULL,
    id_veiculo INTEGER NOT NULL,
    id_motorista INTEGER NOT NULL,
    FOREIGN KEY (id_veiculo) REFERENCES veiculos(id_veiculo),
    FOREIGN KEY (id_motorista) REFERENCES motoristas(id_motorista)
);

CREATE TABLE rotas_pedidos (
    id_rota INTEGER NOT NULL,
    id_pedido INTEGER NOT NULL,
    ordem_entrega INTEGER NOT NULL CHECK (ordem_entrega > 0),
    PRIMARY KEY (id_rota, id_pedido),
    FOREIGN KEY (id_rota) REFERENCES rotas(id_rota) ON DELETE CASCADE,
    FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido) ON DELETE CASCADE
);

CREATE TABLE dados_pagamentos (
    id_pagamento INTEGER PRIMARY KEY,
    data_pagamento DATE NOT NULL,
    forma_pagamento VARCHAR(50) NOT NULL,
    valor_pagamento NUMERIC(10,2) NOT NULL CHECK (valor_pagamento > 0),
    id_cliente INTEGER NOT NULL,
    id_pedido INTEGER NOT NULL,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente),
    FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido)
);

