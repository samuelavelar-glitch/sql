SELECT titulo_livro,multa
FROM emprestimos
WHERE data_devolucao IS NULL;

SELECT l.nome , e.titulo_livro 
FROM leitores l
LEFT JOIN emprestimos e
ON l.id_leitor = e.id_leitor

SELECT l.nome,SUM(e.multa)  
FROM leitores l
INNER JOIN emprestimos e
ON l.id_leitor = e.id_leitor
GROUP BY l.id_leitor , l.nome
HAVING SUM (e.multa) > 10;
